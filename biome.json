{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!sanity.types.ts",
      "!**/.next",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!scripts",
      "!docs",
      "!output",
      "!tmp",
      "!tmp_*",
      "!**/*backup*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn",
        "noFocusedTests": "warn"
      },
      "a11y": {
        "noStaticElementInteractions": "warn"
      },
      "style": {
        "useImportType": "warn",
        "useConsistentArrayType": {
          "level": "warn",
          "options": {
            "syntax": "shorthand"
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/src/app/studio/**/*.*", "**/sanity.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next-sanity": "\n 🔥 Importing the next-sanity package into the Sanity studio is not allowed. Read more about this in the sanity-ignite Readme.md"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/app/(frontend)/**/*.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/studio/*": "\n 🔥 Importing files from sanity studio into the Next.js app is not allowed. Read more about this in the sanity-ignite Readme.md",
                  "@sanity/assist": "\n 🔥 Importing files from sanity studio into the Next.js app is not allowed. Read more about this in the sanity-ignite Readme.md",
                  "@sanity/icons": "\n 🔥 Importing files from sanity studio into the Next.js app is not allowed. Read more about this in the sanity-ignite Readme.md",
                  "@sanity/vision": "\n 🔥 Importing files from sanity studio into the Next.js app is not allowed. Read more about this in the sanity-ignite Readme.md"
                }
              }
            }
          }
        }
      }
    }
  ]
}
