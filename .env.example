# ============================================================
# Drema UI redesign — isolated UI/staging repository
# Staging-only. NEVER put real production credentials in this file.
# The SANITY_API_READ_TOKEN must be a staging-scoped, READ-ONLY token.
# ============================================================

# --- Sanity (staging dataset) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_STUDIO_URL=

# --- Site URL (preview origin; never the production domain) ---
# Used for canonical URLs, sitemap, robots and Studio "view live" links.
NEXT_PUBLIC_SITE_URL=

# --- Server-only Sanity access (READ-ONLY, staging-scoped) ---
# Passed as both serverToken and browserToken by src/lib/sanity/client/live.ts,
# so it is exposed to browsers: it MUST be a read-only, staging-scoped token.
SANITY_API_READ_TOKEN=

# --- Static generation ---
MAX_STATIC_PARAMS=1000

# --- Optional analytics (public IDs only; leave empty to disable) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
